# TirpScanner API (.env) — copy to .env and fill real secrets. Never commit .env.

# --- Wired: read by the Go API at boot (see internal/platform/bootstrap.go) ---
APP_ENV=development
APP_DOMAIN=tirpscanr.com
HTTP_PORT=8080

# PostgreSQL 16 (docker-compose service `postgres`, or managed PG in prod)
DATABASE_URL=postgres://tirpscanner:tirpscanner_dev_password_only@localhost:5432/tirpscanner_dev?sslmode=disable

# Redis 7.4 (rate limit counters, cache)
REDIS_URL=redis://localhost:6379/0

# OpenSearch 2.x (faceted catalog search; falls back to in-memory when unreachable)
OPENSEARCH_URL=http://localhost:9200

# AWS KMS key ARN (or Vault transit path) for platform credential envelope encryption.
# Dev default uses the in-process mock KMS. Production MUST set a real key.
KMS_KEY_ID=local-dev-mock-key-001

# Auth token signing secret (min 32 random bytes, base64). REQUIRED in production.
AUTH_TOKEN_SECRET=dev-only-change-me-please-use-32-plus-random-bytes

# Affiliate SubID/ClickID HMAC signing secret (min 32 random bytes). REQUIRED in production.
AFFILIATE_SIGNING_SECRET=dev-only-change-me-please-use-32-plus-random-bytes

# Browser origins allowed to call the API (comma-separated, exact match).
# Include local dev and the Cloudflare Pages origins (apex + previews).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Re-register the retired 2026-11-26 /cloud/* BYOC routes. Default off.
ENABLE_RETIRED_CLOUD_ROUTES=false

# --- Planned: not read by code yet. Kept as integration notes. ---
# Affiliate network webhook secrets (network=secret pairs).
# Example: AFFILIATE_NETWORK_SECRETS=impact=sec1,partnerstack=sec2
# SMTP for transactional mail (verification, alerts). Empty = log-only mode.
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASSWORD= SMTP_FROM=no-reply@tirpscanr.com

# --- Retired 2026-11-26 (BYOC removed; kept for history, never set) ---
# OAUTH_DO_CLIENT_ID= OAUTH_DO_CLIENT_SECRET=
# OAUTH_DO_REDIRECT_URL=https://tirpscanr.com/api/v1/cloud/oauth/digitalocean/callback

# Safety: live billable cloud tests are ALWAYS off unless explicitly enabled.
# (Test-harness convention; not read by the API.)
ALLOW_LIVE_BILLABLE_TESTS=false

# Frontend build-time API origin (Cloudflare Pages env var, NOT read here):
# NUXT_PUBLIC_API_BASE=https://api.tirpscanr.com
# NITRO_PRESET=cloudflare-pages
