# CloudScanr API (.env) — copy to .env and fill real secrets. Never commit .env.
APP_ENV=development
APP_DOMAIN=cloudscanr.com
HTTP_PORT=8080

# PostgreSQL 16 (docker-compose service `postgres`, or managed PG in prod)
DATABASE_URL=postgres://cloudscanr:cloudscanr_dev_password_only@localhost:5432/cloudscanr_prod?sslmode=disable

# Redis 7.4 (rate limit counters, idempotency locks, cache)
REDIS_URL=redis://localhost:6379/0

# OpenSearch 2.x (faceted catalog search; falls back to in-memory when unreachable)
OPENSEARCH_URL=http://localhost:9200

# AWS KMS key ARN (or Vault transit path) for BYOC credential envelope encryption.
# Dev default uses the in-process mock KMS. Production MUST set a real key.
KMS_KEY_ID=local-dev-mock-key-001

# Auth token signing secret (min 32 random bytes, base64). REQUIRED in production.
AUTH_TOKEN_SECRET=dev-only-change-me-please-use-32-plus-random-bytes

# Affiliate SubID/ClickID HMAC signing secret (min 32 random bytes). REQUIRED in production.
AFFILIATE_SIGNING_SECRET=dev-only-change-me-please-use-32-plus-random-bytes

# Comma-separated affiliate network webhook secrets: network=secret pairs.
# Example: AFFILIATE_NETWORK_SECRETS=impact=sec1,partnerstack=sec2
AFFILIATE_NETWORK_SECRETS=

# OAuth2 BYOC apps (DigitalOcean, Hetzner, UpCloud, Vultr). Empty = token-only mode.
OAUTH_DO_CLIENT_ID=
OAUTH_DO_CLIENT_SECRET=
OAUTH_DO_REDIRECT_URL=https://cloudscanr.com/api/v1/cloud/oauth/digitalocean/callback

# SMTP for transactional mail (verification, alerts). Empty = log-only mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@cloudscanr.com

# Safety: live billable cloud tests are ALWAYS off unless explicitly enabled.
ALLOW_LIVE_BILLABLE_TESTS=false
