# Multi-stage build for CloudScanr Nuxt 3 SSR
FROM node:24-alpine AS builder

WORKDIR /app
COPY web/package.json ./
RUN npm install

COPY web/ ./
RUN npm run build

FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

COPY --from=builder /app/.output ./

EXPOSE 3000
USER node

ENTRYPOINT ["node", "server/index.mjs"]

