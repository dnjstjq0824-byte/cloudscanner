# Multi-stage build for TirpScanner catalog/deal-ingestion worker
FROM golang:1.27-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-w -s" -o /bin/worker ./cmd/worker

FROM alpine:3.20
RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app
COPY --from=builder /bin/worker /app/worker
COPY --from=builder /app/03_DATABASE/migrations /app/migrations

USER nobody:nobody

ENTRYPOINT ["/app/worker"]
