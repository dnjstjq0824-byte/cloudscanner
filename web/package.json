  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.12.2",
    "@types/node": "^22.10.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.1.6"
  }
}
